   "id": "c6a9ccc9-6d52-4521-abff-e08f28eb3d21",
   "metadata": {},
   "outputs": [],
   "source": [
    "brands = [\n",
    "    \"Hero\",\"Honda\",\"TVS\",\"Yamaha\",\"Bajaj\",\n",
    "    \"Royal Enfield\",\"KTM\",\"Suzuki\",\"Ather\",\n",
    "    \"VIDA\",\"Yezdi\",\"Chetak\"\n",
    "]\n",
    "\n",
    "def get_brand(name):\n",
    "    for brand in brands:\n",
    "        if brand.lower() in name.lower():\n",
    "            return brand\n",
    "    return \"Other\"\n",
    "\n",
    "df[\"Brand\"] = df[\"Product_Name\"].apply(get_brand)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "a133ef26-f37c-43d0-bc6b-580a6553e57b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def bike_type(name):\n",
    "    name = name.lower()\n",
    "\n",
    "    if \"electric\" in name:\n",
    "        return \"Electric\"\n",
    "\n",
    "    elif \"scooter\" in name:\n",
    "        return \"Scooter\"\n",
    "\n",
    "    else:\n",
    "        return \"Motorcycle\"\n",
    "\n",
    "df[\"Bike_Type\"] = df[\"Product_Name\"].apply(bike_type)"
   ]
  },
