   "source": [
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "import pandas as pd\n",
    "\n",
    "all_names = []\n",
    "all_specs = []\n",
    "all_price = []\n",
    "all_ratings = []\n",
    "No_of_ratings = []\n",
    "No_of_reviews = []\n",
    "\n",
    "for page in range(1, 30):\n",
    "\n",
    "    url = f\"https://www.flipkart.com/search?q=bikes&page={page}\"\n",
    "\n",
    "    response = requests.get(url, headers=headers)\n",
    "\n",
    "    print(page, response.status_code)\n",
    "\n",
    "    soup = BeautifulSoup(response.text, \"html.parser\")\n",
    "\n",
    "    # Product Name\n",
    "    names = soup.find_all(\"div\", class_=\"RG5Slk\")\n",
    "\n",
    "    # Specifications\n",
    "    specs = soup.find_all(\"div\", class_=\"CMXw7N\")\n",
    "\n",
    "    # price \n",
    "    price = soup.find_all(\"div\",class_=\"hZ3P6w DeU9vF\")\n",
    "\n",
    "    # Rating \n",
    "    rating = soup.find_all(\"div\",class_=\"MKiFS6\")\n",
    "\n",
    "    # No of Ratings\n",
    "    ratings_no = soup.find_all(\"span\",class_=\"PvbNMB\")\n",
    "\n",
    "    # No of Reviews\n",
    "    reviews_no = soup.find_all(\"span\",class_=\"PvbNMB\")\n",
    "\n",
    "    for n in names:\n",
    "        all_names.append(n.text.strip())\n",
    "\n",
    "    for s in specs:\n",
    "        all_specs.append(s.text.strip())\n",
    "    for p in price:\n",
    "        all_price.append(p.text.strip())\n",
    "    for r in rating:\n",
    "        all_ratings.append(r.text.strip())\n",
    "    for nr in ratings_no:\n",
    "        No_of_ratings.append(nr.text.strip())\n",
    "    for nre in reviews_no:\n",
    "        No_of_reviews.append(nre.text.strip())\n"
   ]
  },
